    public async Task<ItemPropertyValue> ResolveFieldValue(JToken pnx, string fieldValue, string lang, string vid)
    {
        try
        {
            ItemPropertyValue link = null;
            fieldValue = fieldValue.Replace("$$V", "");
            if (fieldValue.Contains("$$O"))
            {
                fieldValue = fieldValue.Substring(0, fieldValue.IndexOf("$$O"));
            }
            if (fieldValue.StartsWith("$$T"))
            {
                string templateName = null;
                string linkText = null;
                string templateParam = null;

                string[] linkPart = fieldValue.Replace("$$T", "").Split(new string[] { "$$D" }, StringSplitOptions.None);
                if (linkPart.Length == 2)
                {
                    templateName = linkPart[0];
                    string[] subLinkPart = linkPart[1].Split(new string[] { "$$1" }, StringSplitOptions.None);
                    linkText = subLinkPart[0];
                    if (subLinkPart.Length == 2)
                    {
                        templateParam = subLinkPart[1];
                    }
                }

                if (string.IsNullOrEmpty(templateName))
                {
                    linkPart = fieldValue.Replace("$$T", "").Split(new string[] { "$$E" }, StringSplitOptions.None);
                    if (linkPart.Length == 2)
                    {
                        templateName = linkPart[0];
                    }
                }


                if (string.IsNullOrEmpty(templateName))
                {
                    linkPart = fieldValue.Replace("$$T", "").Split(new string[] { "$$1" }, StringSplitOptions.None);
                    if (linkPart.Length == 2)
                    {
                        templateName = linkPart[0];
                        templateParam = linkPart[1];
                    }
                }

                if (string.IsNullOrEmpty(templateName))
                {
                    templateName = linkPart[0];
                }

                if (!string.IsNullOrEmpty(templateName))
                {
                    string[] templateAndParam = templateName.Split(new string[] { "$$1" }, StringSplitOptions.None);
                    if (templateAndParam.Length == 2)
                    {
                        templateName = templateAndParam[0];
                        templateParam = templateAndParam[1];
                        if (templateName == "Almaviewit_ItemPage")
                        {
                            linkText = "openurl";
                        }
                    }
                }
                /*
                if (templateName != null && templateName.StartsWith("Almaviewit_ItemPage"))
                {
                    string[] AlmaviewitFields = templateName.Split(new string[] { "$$1" }, StringSplitOptions.None);
                    if (AlmaviewitFields.Length == 2)
                    {
                        templateName = AlmaviewitFields[0];
                        templateParam = AlmaviewitFields[1];
                        linkText = "openurl";
                    }
                }*/

                link = ResolveTemplate(pnx, templateName, templateParam, linkText);

                if (templateName == "Almaviewit_ItemPage")
                {
                    switch (lang.ToLower())
                    {
                        case "he":
                            link.link += "heb";
                            break;
                        case "en":
                            link.link += "eng";
                            break;
                        case "ar":
                            link.link += "ara";
                            break;
                        default:
                            link.link += "heb";
                            break;
                    }
                }
            }

            if (fieldValue.StartsWith("$$U"))
            {
                string[] linkPart = fieldValue.Replace("$$U", "").Split(new string[] { "$$D" }, StringSplitOptions.None);
                if (linkPart.Length == 2)
                {
                    link = new ItemPropertyValue()
                    {
                        text = linkPart[1],
                        link = linkPart[0]
                    };
                }
                else
                {
                    linkPart = fieldValue.Replace("$$U", "").Split(new string[] { "$$E" }, StringSplitOptions.None);
                    if (linkPart.Length == 2)
                    {
                        string TranslatedE = await Translate(vid, lang, "fulldisplay." + linkPart[1]);
                        link = new ItemPropertyValue()
                        {
                            text = TranslatedE,
                            link = linkPart[0]
                        };
                    }
                }
            }

            return link;
        }
        catch (Exception e)
        {
            _logger.LogError("error in resolveFieldValue " + e.Message);
            return null;
        }
    }

    private ItemPropertyValue ResolveTemplate(JToken pnx, string templateName, string templateParam, string linkText)
    {
        try
        {
            ItemPropertyValue link = null;

            Dictionary<string, string> templateList = _cache.GetOrCreate("PrimoNUIService-GetTemplateList", entry => GetTemplateList());
            Dictionary<string, string> institutionBaseUrlsList = _cache.GetOrCreate("PrimoNUIService-GetInstitutionBaseUrls", entry => GetInstitutionBaseUrls());

            //Dictionary<string, string> templateList = _cache.GetOrCreate("PrimoNUIService-GetTemplateList", () => GetTemplateList());
            //Dictionary<string, string> institutionBaseUrlsList = _cache.GetOrAdd("PrimoNUIService-GetInstitutionBaseUrls", () => GetInstitutionBaseUrls());

            string linkTemplate;
            if (templateList.TryGetValue(templateName, out linkTemplate))
            {
                // extract variable name
                List<string> variables = Regex.Matches(linkTemplate, "{{(.*?)}}").Cast<Match>().Select(m => m.Value).ToList();
                // resolve variable name to value
                // and replace varaible name by value in template
                foreach (string variable in variables)
                {
                    string value = string.Empty;

                    string baseUrl;
                    if (institutionBaseUrlsList.TryGetValue(variable.Replace("{{", "").Replace("}}", ""), out baseUrl))
                    {
                        value = baseUrl;
                    }

                    if (string.IsNullOrEmpty(value))
                    {
                        switch (variable)
                        {
                            case "{{timestamp}}":
                                value = HttpUtility.UrlEncode(DateTime.Now.ToString("yyyy-MM-ddTHH:mm:ssIST"));
                                break;
                            case "{{language_bibliographic}}":
                                value = "heb";
                                break;
                            case "{{$$1}}":
                                value = templateParam;
                                break;
                            default:
                                break;
                        }
                    }
                    if (string.IsNullOrEmpty(value))
                    {
                        // get from pnx
                        string token = variable.Replace("{{", "").Replace("}}", "").Replace("/", ".");
                        value = ExtractFirstValueFromPNX(pnx, token);
                        linkTemplate = linkTemplate.Replace(variable, HttpUtility.UrlEncode(value));
                    }
                    else
                    {
                        linkTemplate = linkTemplate.Replace(variable, value);
                    }
                }
                link = new ItemPropertyValue()
                {
                    text = linkText,
                    link = linkTemplate
                };
            }
            return link;
        }
        catch (Exception e)
        {
            _logger.LogError("error in ResolveTemplate " + e.Message);
            return null;
        }
    }

    private Dictionary<string, string> GetInstitutionBaseUrls(string vid = "NLI")
    {
        try
        {
            Dictionary<string, string> result = new Dictionary<string, string>();

            JToken configuration = GetConfiguration(vid);
            if (configuration != null)
            {
                string token = "mapping-tables.['Institution Base URLs']";
                JArray institutionBaseUrls = (JArray)configuration.SelectToken(token);
                institutionBaseUrls.ToList().ForEach(x =>
                {
                    if (!result.ContainsKey(x.Value<string>("source2")))
                    {
                        result.Add(x.Value<string>("source2"), x.Value<string>("target"));
                    }
                });
            }
            else
            {
                result = GetInstitutionBaseUrlsFromFile();
            }

            return result;
        }
        catch (Exception e)
        {
            _logger.LogError("error in GetInstitutionBaseUrls " + e.Message);
            return null;
        }
    }

    private Dictionary<string, string> GetInstitutionBaseUrlsFromFile()
    {
        Dictionary<string, string> templateList = new Dictionary<string, string>();

        try
        {
            string environment = _configuration["Environment"] ?? "";
            string fileName = $"mapping_tables_institution_base_urls_{environment}.json";
            string filePath = Path.Combine(_webHostEnvironment.ContentRootPath, "App_Data", fileName);

            if (!File.Exists(filePath))
            {
                return templateList; // Return an empty dictionary if file is missing
            }

            using (StreamReader file = File.OpenText(filePath))
            using (JsonTextReader reader = new JsonTextReader(file))
            {
                JArray templates = (JArray)JToken.ReadFrom(reader);
                templates.ToList().ForEach(x =>
                {
                    templateList.Add(x.Value<string>("Code"), x.Value<string>("URL"));
                });
            }

            return templateList;
        }
        catch (Exception e)
        {
            _logger.LogError("error in GetInstitutionBaseUrlsFromFile " + e.Message);
            return templateList;
        }
    }

    private Dictionary<string, string> GetTemplateList()
    {
        Dictionary<string, string> templateList = new Dictionary<string, string>();
        try
        {
            string environment = _configuration["Environment"] ?? "default";
            string fileName = $"mapping_tables_templates_{environment}.json";
            string filePath = Path.Combine(_webHostEnvironment.ContentRootPath, "App_Data", fileName);

            if (!File.Exists(filePath))
            {
                return templateList; // Return an empty dictionary if file is missing
            }

            using (StreamReader file = File.OpenText(filePath))
            using (JsonTextReader reader = new JsonTextReader(file))
            {
                JArray templates = (JArray)JToken.ReadFrom(reader);
                foreach (var item in templates)
                {
                    templateList[item.Value<string>("Code")] = item.Value<string>("Template Code");
                }
            }

            return templateList;
        }
        catch (Exception e)
        {
            _logger.LogError("error in GetTemplateList " + e.Message);
            return templateList;
        }
    }


    private string ExtractFirstValueFromPNX(JToken pnx, string token)
    {
        string value = null;
        JToken tokenTag = pnx.SelectToken(token);
        if (tokenTag != null)
        {
            List<string> valueList = tokenTag.ToObject<List<string>>();
            if (valueList.Count > 0)
            {
                value = valueList[0];
            }
        }
        return value;
    }

    public List<string> CleanFieldValue(List<string> values)
    {
        List<string> cleanValues = new List<string>();
        values.ForEach(s => cleanValues.Add(HttpUtility.HtmlDecode(s)));
        return cleanValues;
    }

    private async Task<string> Translate(string vid, string lang, string token)
    {
        string result = null;
        JToken translations = await GetTranslation(vid, lang);
        if (translations != null)
        {
            var translation = translations.SelectToken(string.Format("['{0}']", token));
            if (translation != null)
            {
                result = translation.ToString();
            }
        }
        return result;
    }

    public async Task<JToken> GetTranslation(string vid, string lang)
    {
        string cacheKey = $"PrimoNUIService-GetTranslation-{vid}-{lang}";

        var result = await _cache.GetOrCreateAsync(cacheKey, async entry =>
        {
            entry.AbsoluteExpirationRelativeToNow = TimeSpan.FromMinutes(30); // Cache for 30 minutes

            JToken translation = null;

            try
            {
                var translationUrl = string.Format(
                    _configuration["Primo:PrimoNewUi"] + _configuration["PrimoUi:viewRestTranslateUrl"],
                    vid,
                    _primo.GetPrimoLang(lang)
                );

                _logger.LogDebug("Fetching translations from: {Url}", translationUrl);

                var response = await _apiClient.SendAsync<string>(
                    HttpMethod.Get,
                    translationUrl,
                    deserializeResponse: false,
                    isXmlResponse: false
                );

                translation = JToken.Parse(response.ToString());
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Failed to get translation for vid: {Vid}, lang: {Lang}", vid, lang);
            }

            // Prevent caching of null values
            return translation ?? new JObject();
        });

        return result ?? new JObject();
    }

    private JToken GetConfiguration(string vid)
    {
        string cacheKey = $"PrimoNUIService-GetConfiguration-{vid}";

        var result = _cache.GetOrCreate(cacheKey, entry =>
        {
            entry.AbsoluteExpirationRelativeToNow = TimeSpan.FromMinutes(30); // Cache for 30 minutes
            var configuration = _primo.GetConfiguration(vid);

            return configuration ?? new JObject();

        });

        return result ?? new JObject();
    }
