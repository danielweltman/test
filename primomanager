    public void ValidateQuery(ref string query)
    {
        if (string.IsNullOrWhiteSpace(query))
            query = string.Empty;

        var lowerCaseQuery = query.ToLowerInvariant();

        if (!lowerCaseQuery.Contains("vid="))
            query += "&vid=NLI";

        if (!lowerCaseQuery.Contains("tab="))
            query += "&tab=default_tab";

        if (!lowerCaseQuery.Contains("scope="))
            query += "&scope=Local";

        if (!lowerCaseQuery.Contains("q="))
            query += "&q=any,contains,הספרייה הלאומית";

        if (!lowerCaseQuery.Contains("inst="))
            query += "&inst=NNL";
    }

    public void ReplaceParams(ref string queryUrl)
    {
        queryUrl = queryUrl.Replace("query=", "q=");
        queryUrl = queryUrl.Replace("search_scope=", "scope=");
        HandleSingleFacet(ref queryUrl);
        HandleMultipleFacet(ref queryUrl);
        queryUrl = queryUrl.Replace("sortby=", "sort=");

    }

    private void HandleSingleFacet(ref string queryUrl)
    {
        queryUrl = UpdatesFacets(queryUrl, "facet", "qInclude");
    }

    private void HandleMultipleFacet(ref string queryUrl)
    {
        queryUrl = UpdatesFacets(queryUrl, "mfacet", "multiFacets");
    }

    private string UpdatesFacets(string queryUrl, string FacetinQuery, string FacetinService)
    {
        if (queryUrl.IndexOf("&" + FacetinQuery) > -1 || queryUrl.IndexOf("?" + FacetinQuery) > -1)
        {
            Uri u = new Uri(queryUrl);
            List<string> facetList = HttpUtility.ParseQueryString(u.Query).GetValues(FacetinQuery).ToList();
            var query = HttpUtility.ParseQueryString(u.Query);
            query.Remove(FacetinQuery);
            string facetQuery = string.Empty;

            if (FacetinService == "multiFacets") // handel multi facet
            {
                Dictionary<string, List<string>> MultiFList = GenerateMultiFacetList(facetList);

                foreach (KeyValuePair<string, List<string>> entry in MultiFList)
                    facetQuery += BuildSingleFacetParam(FacetinService, entry.Value);
            }
            else // single facet
                facetQuery = BuildSingleFacetParam(FacetinService, facetList);

            queryUrl = u.GetLeftPart(UriPartial.Path) + "?" + query + facetQuery;
        }
        return queryUrl;

    }

    private Dictionary<string, List<string>> GenerateMultiFacetList(List<string> facetList)
    {
        Dictionary<string, string> temp = new Dictionary<string, string>();
        foreach (string facet in facetList)
        {
            string[] splitted = facet.Split(',');
            if (splitted.Length == 4)
                temp.Add(splitted[0] + "," + splitted[1] + "," + splitted[2], splitted[3]);

        }
        Dictionary<string, List<string>> MultiFList =
          temp.GroupBy(r => r.Value)
         .ToDictionary(t => t.Key, t => t.Select(r => r.Key).ToList());
        return MultiFList;
    }

    private string BuildSingleFacetParam(string FacetinService, List<string> facetList)
    {
        string facetQuery = "&" + FacetinService + "=";
        string lastFacet = facetList.Last();
        foreach (string facet in facetList)
            if (facet != lastFacet)
                facetQuery = facetQuery + "facet_" + facet + "|,|";
            else
                facetQuery = facetQuery + "facet_" + facet;

        return facetQuery;
    }

    public string GetPartnerDocId(JToken pnx)
    {
        try
        {
            if (pnx == null)
                return string.Empty;

            string configField = _configuration["PrimoUi:ItemCopyrightPartnerField"];

            if (string.IsNullOrWhiteSpace(configField))
                return string.Empty; // Avoid using a bad or empty key

            JToken profile = pnx.SelectToken($"addata.{configField}");
            return profile?.ToObject<List<string>>()?.FirstOrDefault() ?? string.Empty;
        }
        catch (Exception e)
        {
            _logger.LogError("error in getPartnerDocId " + e.Message);
            return string.Empty;
        }

    }
