using System;
using System.Collections.Generic;
using System.Linq;
using Microsoft.Extensions.Configuration;
using Microsoft.Extensions.Logging;
using Newtonsoft.Json.Linq;

public class PrimoManager
{
    private readonly IConfiguration _configuration;
    private readonly ILogger<PrimoManager> _logger;

    public PrimoManager(IConfiguration configuration, ILogger<PrimoManager> logger)
    {
        _configuration = configuration;
        _logger = logger;
    }

    public void ValidateQuery(ref string query)
    {
        if (string.IsNullOrWhiteSpace(query))
        {
            _logger.LogWarning("Query is null or empty. Initializing as empty.");
            query = string.Empty;
        }

        var lowerQuery = query.ToLowerInvariant();

        AppendIfMissing(ref query, lowerQuery, "vid=", "&vid=NLI");
        AppendIfMissing(ref query, lowerQuery, "tab=", "&tab=default_tab");
        AppendIfMissing(ref query, lowerQuery, "scope=", "&scope=Local");
        AppendIfMissing(ref query, lowerQuery, "q=", "&q=any,contains,הספרייה הלאומית");
        AppendIfMissing(ref query, lowerQuery, "inst=", "&inst=NNL");

        _logger.LogInformation("Validated query: {Query}", query);
    }

    private void AppendIfMissing(ref string query, string lowerQuery, string key, string appendValue)
    {
        if (!lowerQuery.Contains(key))
        {
            _logger.LogDebug("Appending missing parameter '{Key}' with value '{Value}'", key, appendValue);
            query += appendValue;
        }
    }

    public string GetPartnerDocId(JToken pnx)
    {
        try
        {
            if (pnx == null)
            {
                _logger.LogWarning("PNX token is null in GetPartnerDocId.");
                return string.Empty;
            }

            string field = _configuration["PrimoUi:ItemCopyrightPartnerField"];
            if (string.IsNullOrWhiteSpace(field))
            {
                _logger.LogWarning("Missing configuration: PrimoUi:ItemCopyrightPartnerField");
                return string.Empty;
            }

            var token = pnx.SelectToken($"addata.{field}");
            string result = token?.ToObject<List<string>>()?.FirstOrDefault() ?? string.Empty;

            _logger.LogInformation("Extracted partner doc ID: {Result}", result);
            return result;
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error in GetPartnerDocId");
            return string.Empty;
        }
    }

    public bool IsDigitoolDoc(JToken pnx)
    {
        try
        {
            if (pnx == null)
            {
                _logger.LogWarning("PNX is null in IsDigitoolDoc.");
                return false;
            }

            var idToken = pnx.SelectToken("control.sourceid");
            var sourceId = idToken?.ToString();

            bool result = !string.IsNullOrWhiteSpace(sourceId) && sourceId.StartsWith("digitool", StringComparison.OrdinalIgnoreCase);

            _logger.LogDebug("IsDigitoolDoc check result: {Result}", result);
            return result;
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error in IsDigitoolDoc");
            return false;
        }
    }

    public string GetRecordId(JToken pnx)
    {
        try
        {
            if (pnx == null)
            {
                _logger.LogWarning("PNX is null in GetRecordId.");
                return string.Empty;
            }

            var recordId = pnx.SelectToken("control.recordid")?.ToString() ?? string.Empty;
            _logger.LogDebug("Extracted record ID: {RecordId}", recordId);
            return recordId;
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error in GetRecordId");
            return string.Empty;
        }
    }

    public string GetHoldingId(JToken pnx)
    {
        try
        {
            if (pnx == null)
            {
                _logger.LogWarning("PNX is null in GetHoldingId.");
                return string.Empty;
            }

            var holdingId = pnx.SelectToken("delivery.holding")?.ToObject<List<string>>()?.FirstOrDefault() ?? string.Empty;
            _logger.LogDebug("Extracted holding ID: {HoldingId}", holdingId);
            return holdingId;
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error in GetHoldingId");
            return string.Empty;
        }
    }
}
